<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yulgnier.center.common.user.mapper.UserMapper">

    <select id="selectOneByNicknameIgnoreLogicDelete" resultType="com.yulgnier.center.common.user.model.domain.CommonUser">
        SELECT *
        FROM t_common_user
        WHERE nickname = #{nickname}
        LIMIT 1
    </select>

    <select id="selectOneByEmailIgnoreLogicDelete" resultType="com.yulgnier.center.common.user.model.domain.CommonUser">
        SELECT *
        FROM t_common_user
        WHERE email = #{email}
        LIMIT 1
    </select>

    <select id="selectOneByUidIgnoreLogicDelete" resultType="com.yulgnier.center.common.user.model.domain.CommonUser">
        SELECT *
        FROM t_common_user
        WHERE uid = #{uid}
        LIMIT 1
    </select>

    <update id="updatePasswordByUidIgnoreLogicDelete">
        UPDATE t_common_user
        SET password = #{password}
        WHERE uid = #{uid}
        LIMIT 1
    </update>

    <update id="restoreUserIgnoreLogicDelete">
        UPDATE t_common_user
        SET is_deleted = 0
        WHERE uid = #{uid}
        LIMIT 1
    </update>


</mapper>
