<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 账号异常状态时间 Mapper XML -->
<mapper namespace="com.yuigneel.center.admin.user.mapper.AccountExceptionStatusTimeMapper">

    <!-- 物理删除异常状态记录 -->
    <delete id="physicalDeleteByUidAndIdentity">
        DELETE FROM t_account_exception_status_time 
        WHERE uid = #{uid} AND identity_type = #{identityType}
    </delete>

</mapper>
