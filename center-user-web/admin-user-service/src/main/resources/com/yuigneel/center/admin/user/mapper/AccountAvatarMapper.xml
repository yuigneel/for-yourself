<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yuigneel.center.admin.user.mapper.AccountAvatarMapper">

    <!-- 根据UID和身份类型物理删除（忽略逻辑删除） -->
    <delete id="deleteByUidAndIdentityTypeIgnoreLogic">
        DELETE FROM t_account_avatar WHERE uid = #{uid} AND identity_type = #{identityType}
    </delete>

</mapper>